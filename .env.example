# ---------------------------------------------------------------------------
# COSMETICS.KS — environment template
#
# Copy to .env.local for development and set the same values in your hosting
# provider for deployed environments:
#
#   cp .env.example .env.local
#
# .env.local is git-ignored. Never commit real secrets.
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Everything else is server-only — if you find yourself wanting to prefix a
# secret with NEXT_PUBLIC_, that is the signal to move the work server-side.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Public base URL, no trailing slash. Drives canonical URLs, the sitemap and
# Open Graph image URLs. On Vercel this is inferred if unset, but set it
# explicitly in production so canonicals never point at a preview domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# --- Admin authentication ---------------------------------------------------
# Required in production. Without both ADMIN_EMAIL and ADMIN_PASSWORD_HASH the
# admin area rejects every sign-in — an unconfigured admin must be closed, not
# open with a default password.
#
# In development only, if these are unset, a local fallback credential is
# accepted and the admin area shows a warning banner. That fallback is disabled
# entirely when NODE_ENV=production.
#
# Generate the hash and a session secret with:
#   node scripts/hash-password.mjs 'your-strong-password'
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

# Signing key for the admin session cookie (HS256 JWT).
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this value invalidates all existing admin sessions.
AUTH_SECRET=""


# --- Data source ------------------------------------------------------------
# "memory" (default) serves the seed catalogue from lib/db/store.ts. Writes live
# in the process: admin edits and orders do not survive a restart and do not
# propagate between serverless instances. Fine for a local look around, not for
# a real store.
#
# "prisma" uses Postgres and is what a deployment should run. See DATABASE.md.
DATA_SOURCE="memory"

# Postgres connection strings. Required when DATA_SOURCE="prisma".
#
# DATABASE_URL is what the app queries through — use the POOLED connection string
# on serverless (Supabase's pgBouncer endpoint, Neon's pooled host), because each
# instance holds its own pool.
#
# DIRECT_URL is used by the Prisma CLI for migrations only. Pooled connections
# cannot run DDL, so set this to the direct/unpooled string. If you leave it
# empty, migrations fall back to DATABASE_URL — fine for a local Postgres.
DATABASE_URL=""
DIRECT_URL=""

# Connections per instance. Keep it small on serverless: every warm instance holds
# its own pool, so a large value exhausts the database's connection limit long
# before it improves throughput. Default 5.
DATABASE_POOL_MAX="5"


# --- Payments (Stripe) ------------------------------------------------------
# Checkout runs in offline mode until BOTH of these are set — see PAYMENTS.md.
# The publishable key is the only payment value that may be public.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Verifies that incoming webhooks genuinely came from Stripe. Required before
# any payment confirmation can be trusted.
STRIPE_WEBHOOK_SECRET=""


# --- Transactional email (optional) -----------------------------------------
# Order confirmations, contact-form notifications and newsletter double opt-in.
# Nothing is sent while these are empty; messages are stored for the admin
# inbox instead.
RESEND_API_KEY=""
EMAIL_FROM="COSMETICS.KS <hello@cosmetics-ks.com>"
EMAIL_REPLY_TO="care@cosmetics-ks.com"
